# =============================================================================
#  Hibou — affichage de l'occupation des salles — configuration du déploiement Docker
#  Copier en .env puis adapter :  cp .env.example .env
# =============================================================================

# --- Serveur -----------------------------------------------------------------
TZ=Europe/Paris
# Port HTTP exposé (utilisé par les écrans)
EPAPER_PORT=8000
# Interface d'écoute (0.0.0.0 = toutes ; mettre l'IP du VLAN écrans pour restreindre)
EPAPER_BIND=0.0.0.0
# Valeurs initiales des réglages (appliquées au premier démarrage uniquement,
# modifiables ensuite dans l'interface > Réglages)
EPAPER_DEFAULT_SITE_NAME=
EPAPER_DEFAULT_DAY_START=07:30
EPAPER_DEFAULT_DAY_END=19:00
EPAPER_DEFAULT_PROV_IP_FIRST=10.20.0.31
EPAPER_DEFAULT_PROV_IP_LAST=10.20.0.250

# --- HTTPS (profil « https », reverse proxy Caddy) ------------------------------
EPAPER_HOSTNAME=ecrans.lan
HTTPS_PORT=443
HTTP_PORT=80

# --- Firmware (compilé dans les écrans par « docker compose run --rm firmware ») ---
# Version : à incrémenter à chaque build (peut aussi être passée avec -e FW_VERSION=…)
FW_VERSION=0.1.0
# Réseau Wi-Fi dédié aux écrans (2,4 GHz, WPA2-PSK)
WIFI_SSID=ECRANS-IOT
WIFI_PASSWORD=changez-moi
# URL du serveur TELLE QUE LES ÉCRANS LA VOIENT (IP du serveur sur le VLAN écrans + EPAPER_PORT)
SERVER_URL=http://10.20.0.10:8000
# Paramètres IP communs ; l'IP de chaque écran est attribuée à la mise en service
NET_GW=10.20.0.1
NET_MASK=255.255.255.0
NET_DNS=10.20.0.1
# 1 = active immédiatement la version compilée (déploiement OTA sur toute la flotte)
ACTIVATE=0
